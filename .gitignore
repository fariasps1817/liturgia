# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...mas o exemplo precisa ir junto: é a documentação do que configurar.
!.env.example

# banco SQLite local usado em desenvolvimento
/.dados/

# Ícones do PWA: gerados de public/icone.svg pelo `prebuild`, nunca editados à
# mão. Ficam fora do repositório para não divergirem do SVG.
/public/icones/
/public/apple-touch-icon.png
/src/app/icon.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Textos do Missal preenchidos pela paróquia. Os direitos da tradução são da
# CNBB: o texto fica na máquina de quem preencheu, não no repositório.
/missal.local.txt

# PDFs e textos do Missal trazidos pela equipe: mesma razão do
# missal.local.txt — os direitos da tradução são da CNBB.
/docs/*.pdf
