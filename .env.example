# Copie para .env.local e preencha. Nada aqui vai para o repositório.

# ── Preces da Assembleia (obrigatório para gerar preces) ──────────────────────
# Chave da API da OpenAI. Fica SÓ no servidor — nunca use o prefixo
# NEXT_PUBLIC_, senão ela vai parar dentro do celular de quem usa o app.
# Pegue em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo usado para redigir as preces.
# gpt-4o-mini → o mais barato (padrão)
# gpt-4o      → redação melhor e mais fiel às normas, custa mais por geração
# Trocar de modelo é só mudar esta linha: nenhuma alteração de código.
MODELO_IA=gpt-4o-mini

# ── Banco das preces ─────────────────────────────────────────────────────────
# Em desenvolvimento pode deixar em branco: cai num arquivo SQLite local
# (.dados/preces.db) e funciona sem cadastro em lugar nenhum.
# Em produção é obrigatório — é o que faz a equipe inteira ver as mesmas preces.
# Crie um banco grátis em https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Fonte das leituras ───────────────────────────────────────────────────────
# Só mexa se for trocar de fonte. Rode `npm run sondar` depois de mudar.
LITURGIA_API_BASE=https://liturgia.up.railway.app/v2

# ── Orações Eucarísticas ─────────────────────────────────────────────────────
# Ligue apenas depois de obter autorização escrita da CNBB para reproduzir o
# texto do Missal. Enquanto estiver desligado, o app mostra as respostas da
# assembleia na íntegra e só as primeiras palavras das falas do celebrante.
MOSTRAR_TEXTO_PRESIDENCIAL=false
